[
    {
        "label": "go: run current project",
        "command": "go",
        "args": ["run", "."],
        "reveal": "always",
    },
    {
        "label": "go: tidy mods",
        "command": "go",
        "args": ["mod", "tidy"],
        "reveal": "always",
    },
    {
        "label": "go: test all",
        "command": "go",
        "args": ["test", "-count=1", "./.."],
        "reveal": "always",
    },
    {
        "label": "go: test internal",
        "command": "go",
        "args": ["test", "-v", "-count=1", "./internal/..."],
        "reveal": "always",
    },
]
